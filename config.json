{
  "video": {
    "path": "videos/clip3-detection.mp4",
    "camera_index": 0,
    "source": "auto"
  },
  "detector": "dnn",
  "cascades": [
    {
      "name": "frontal_alt",
      "path": "cascades/haarcascade_frontalface_alt.xml",
      "enabled": true,
      "min_neighbors": 3
    },
    {
      "name": "frontal_default",
      "path": "cascades/haarcascade_frontalface_default.xml",
      "enabled": true,
      "min_neighbors": 5,
      "min_weight": 2
    }
  ],
  "dnn": {
    "model_path": "models/face_detection_yunet_2026may.onnx",
    "score_threshold": 0.7,
    "nms_threshold": 0.3,
    "top_k": 5000
  },
  "eyes": {
    "enabled": true,
    "source": "auto",
    "cascade_path": "cascades/haarcascade_eye.xml",
    "scale_factor": 1.1,
    "min_neighbors": 2,
    "min_size": [10, 10],
    "verify_haar_faces": false,
    "min_eyes": 1
  },
  "detection": {
    "scale_factor": 1.05,
    "min_neighbors": 3,
    "min_size": [24, 24],
    "max_size": null,
    "max_faces": 0,
    "min_cascade_agreement": 2,
    "detect_every_n_frames": 1
  },
  "tracking": {
    "enabled": true,
    "smoothing": 0.4,
    "face_hold_frames": {
      "haar": 1,
      "dnn": 0
    },
    "eye_hold_frames": 15
  },
  "display": {
    "enabled": true
  }
}
